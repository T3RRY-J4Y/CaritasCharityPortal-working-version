@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Register - Caritas</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <style>
            .error-message {
                color: #dc2626;
                font-size: 0.85rem;
                margin-top: 8px;
                text-align: center;
            }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-container">
            <h2 class="brand-subtitle" style="margin-bottom:20px;">Join Caritas to make a difference</h2>
            <div class="login-card">
                <h3>Register</h3>
                <p class="login-subtext">Fill in your details to create an account</p>
                <form id="registerForm">
                    <div class="form-row">
                        <div><label>Full Name</label><input type="text" id="fullName" placeholder="John Doe" required /></div>
                        <div><label>Email</label><input type="email" id="email" placeholder="your.email@example.com" required /></div>
                    </div>
                    <div class="form-row">
                        <div><label>Phone Number</label><input type="text" id="phone" placeholder="+27 12 345 6789" required /></div>
                        <div><label>Location</label><input type="text" id="location" placeholder="City, Province" required /></div>
                    </div>
                    <div class="form-row">
                        <div><label>Password</label><input type="password" id="password" placeholder="••••••••" required /></div>
                        <div><label>Confirm Password</label><input type="password" id="confirmPassword" placeholder="••••••••" required /></div>
                    </div>
                    <button type="submit" class="login-btn">Create Account</button>
                    <div id="errorMsg" class="error-message"></div>
                </form>
            </div>
            <div class="register-link">
                <span>Already have an account?</span><a href="/Account/Login">Sign in here</a>
            </div>
        </div>
    </div>
    <script>
            var atSymbol = String.fromCharCode(64);
            function isValidEmail(email) {
                var atIndex = email.indexOf(atSymbol);
                if (atIndex < 0) return false;
                var dotIndex = email.lastIndexOf('.');
                if (dotIndex < atIndex + 2) return false;
                return true;
            }
            document.getElementById("registerForm").addEventListener("submit", async function(e) {
                e.preventDefault();
                var fullName = document.getElementById("fullName").value.trim();
                var email = document.getElementById("email").value.trim();
                var phone = document.getElementById("phone").value.trim();
                var location = document.getElementById("location").value.trim();
                var password = document.getElementById("password").value;
                var confirm = document.getElementById("confirmPassword").value;
                if (password !== confirm) {
                    document.getElementById("errorMsg").innerText = "Passwords do not match.";
                    return;
                }
                if (password.length < 6) {
                    document.getElementById("errorMsg").innerText = "Password must be at least 6 characters.";
                    return;
                }
                if (!isValidEmail(email)) {
                    document.getElementById("errorMsg").innerText = "Invalid email address.";
                    return;
                }
                var data = {
                    fullName: fullName,
                    email: email,
                    phone: phone,
                    location: location,
                    password: password,
                    confirmPassword: confirm
                };
                try {
                    var response = await fetch("/Account/Register", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(data)
                    });
                    var result = await response.json();
                    if (response.ok && result.success) {
                        alert("Registration successful! Please log in.");
                        window.location.href = "/Account/Login";
                    } else {
                        document.getElementById("errorMsg").innerText = result.message || "Registration failed.";
                    }
                } catch (ex) {
                    document.getElementById("errorMsg").innerText = "Network error. Please try again.";
                }
            });
    </script>
</body>
</html>