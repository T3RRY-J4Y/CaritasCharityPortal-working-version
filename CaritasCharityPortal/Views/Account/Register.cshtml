@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Register – Caritas St Thomas More</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--red:#c8102e;--red-dark:#9b0b21;--gold:#c9944b;--cream:#fdf8f3;--dark:#1c1008;--grey:#7a6858;--border:#e8e0d8;}
body{font-family:'Jost',sans-serif;background:var(--cream);min-height:100vh;display:flex;align-items:stretch}
.auth-page{display:grid;grid-template-columns:1fr 1fr;min-height:100vh;width:100%}

.auth-panel{
  background:linear-gradient(145deg,#1c0a0a 0%,#3a0d1a 60%,#1c0a0a 100%);
  display:flex;flex-direction:column;justify-content:space-between;
  padding:48px;position:relative;overflow:hidden;
}
.auth-panel::before{
  content:'';position:absolute;inset:0;
  background:url('/images/outreach2.jpg') center/cover no-repeat;
  opacity:0.15;
}
.panel-top{position:relative;z-index:1}
.panel-brand{display:flex;align-items:center;gap:12px;margin-bottom:64px}
.panel-logo{width:44px;height:44px;object-fit:contain}
.panel-wordmark strong{display:block;font-family:'Cormorant Garamond',serif;font-size:20px;color:#fff;font-weight:700}
.panel-wordmark span{font-size:11px;color:rgba(255,255,255,0.5);letter-spacing:.5px;text-transform:uppercase}
.panel-heading{font-family:'Cormorant Garamond',serif;font-size:clamp(34px,4vw,48px);font-weight:700;color:#fff;line-height:1.1;margin-bottom:20px}
.panel-heading em{color:var(--gold);font-style:normal}
.panel-sub{font-size:15px;color:rgba(255,255,255,0.65);line-height:1.75;max-width:380px}
.panel-perks{position:relative;z-index:1;display:flex;flex-direction:column;gap:14px}
.perk{display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.75);font-size:13px}
.perk i{width:32px;height:32px;background:rgba(255,255,255,0.08);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:13px;flex-shrink:0}

.auth-form-side{
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  padding:48px;background:var(--cream);overflow-y:auto;
}
.auth-form-inner{width:100%;max-width:460px}
.auth-back{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--grey);text-decoration:none;margin-bottom:32px;transition:color .2s}
.auth-back:hover{color:var(--red)}
.auth-title{font-family:'Cormorant Garamond',serif;font-size:34px;font-weight:700;color:var(--dark);margin-bottom:6px}
.auth-subtitle{font-size:14px;color:var(--grey);margin-bottom:28px}

.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{margin-bottom:16px}
.field label{display:block;font-size:12px;font-weight:700;color:var(--dark);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.field input{
  width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:6px;
  font-family:'Jost',sans-serif;font-size:14px;color:var(--dark);background:#fff;
  transition:border-color .2s,box-shadow .2s;outline:none;
}
.field input:focus{border-color:var(--red);box-shadow:0 0 0 3px rgba(200,16,46,0.08)}
.field input::placeholder{color:#bbb}

.strength-bar{height:3px;border-radius:100px;background:#e5e7eb;margin-top:6px;overflow:hidden}
.strength-fill{height:100%;border-radius:100px;width:0;transition:width .3s,background .3s}

.btn-auth{
  width:100%;padding:14px;background:var(--red);color:#fff;border:none;border-radius:6px;
  font-family:'Jost',sans-serif;font-size:15px;font-weight:700;cursor:pointer;
  transition:all .25s;letter-spacing:.3px;margin-top:8px;
  display:flex;align-items:center;justify-content:center;gap:8px;
}
.btn-auth:hover{background:var(--red-dark);transform:translateY(-1px);box-shadow:0 6px 20px rgba(200,16,46,0.25)}
.auth-error{color:#dc2626;font-size:12px;margin-top:10px;text-align:center;min-height:18px}
.auth-footer{text-align:center;font-size:13px;color:var(--grey);margin-top:20px}
.auth-footer a{color:var(--red);font-weight:600;text-decoration:none}
.auth-footer a:hover{text-decoration:underline}
.terms-note{font-size:11px;color:var(--grey);text-align:center;margin-top:12px;line-height:1.6}

@@media(max-width:768px){
  .auth-page{grid-template-columns:1fr}
  .auth-panel{display:none}
  .auth-form-side{padding:32px 24px}
  .form-row{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="auth-page">

  <div class="auth-panel">
    <div class="panel-top">
      <div class="panel-brand">
        <img src="~/images/logo.png" alt="Caritas Logo" class="panel-logo"/>
        <div class="panel-wordmark">
          <strong>Caritas</strong>
          <span>St Thomas More</span>
        </div>
      </div>
      <h2 class="panel-heading">Join the Mission.<br/>Make a <em>Real Difference.</em></h2>
      <p class="panel-sub">Create your account to start donating, volunteering, or requesting assistance from the Caritas community.</p>
    </div>
    <div class="panel-perks">
      <div class="perk"><i class="fa-solid fa-heart"></i> Submit food, clothing and monetary donations</div>
      <div class="perk"><i class="fa-solid fa-hand-holding-heart"></i> Request assistance for your family</div>
      <div class="perk"><i class="fa-solid fa-users"></i> Join our volunteer network</div>
      <div class="perk"><i class="fa-solid fa-shield-halved"></i> Your data is private and secure</div>
    </div>
  </div>

  <div class="auth-form-side">
    <div class="auth-form-inner">

      <a href="/Account/Login" class="auth-back">
        <i class="fa-solid fa-arrow-left"></i> Back to Sign In
      </a>

      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Fill in your details to get started</p>

      <form id="registerForm">
        <div class="form-row">
          <div class="field">
            <label>Full Name</label>
            <input type="text" id="fullName" placeholder="John Doe" required/>
          </div>
          <div class="field">
            <label>Email Address</label>
            <input type="email" id="email" placeholder="your.email@example.com" required/>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Phone Number</label>
            <input type="tel" id="phone" placeholder="+27 12 345 6789" required/>
          </div>
          <div class="field">
            <label>Location</label>
            <input type="text" id="location" placeholder="City, Province" required/>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Password</label>
            <input type="password" id="password" placeholder="Min. 6 characters" required oninput="checkStrength(this.value)"/>
            <div class="strength-bar"><div class="strength-fill" id="strengthBar"></div></div>
          </div>
          <div class="field">
            <label>Confirm Password</label>
            <input type="password" id="confirmPassword" placeholder="Repeat password" required/>
          </div>
        </div>
        <button type="submit" class="btn-auth">
          <i class="fa-solid fa-user-plus"></i> Create Account
        </button>
        <div id="errorMsg" class="auth-error"></div>
      </form>

      <p class="terms-note">By registering you agree to the Caritas St Thomas More terms of use and privacy policy.</p>
      <div class="auth-footer">
        Already have an account? <a href="/Account/Login">Sign in here</a>
      </div>

    </div>
  </div>

</div>
<script>
function checkStrength(val) {
  var bar = document.getElementById("strengthBar");
  var score = 0;
  if (val.length >= 6)  score++;
  if (val.length >= 10) score++;
  if (/[A-Z]/.test(val)) score++;
  if (/[0-9]/.test(val)) score++;
  if (/[^A-Za-z0-9]/.test(val)) score++;
  var widths = ["0%","20%","40%","60%","80%","100%"];
  var colors = ["#e5e7eb","#ef4444","#f97316","#eab308","#22c55e","#16a34a"];
  bar.style.width = widths[score];
  bar.style.background = colors[score];
}

var atSymbol = String.fromCharCode(64);
function isValidEmail(email) {
  var atIndex = email.indexOf(atSymbol);
  if (atIndex < 0) return false;
  var dotIndex = email.lastIndexOf('.');
  if (dotIndex < atIndex + 2) return false;
  return true;
}

document.getElementById("registerForm").addEventListener("submit", async function(e) {
  e.preventDefault();
  var fullName = document.getElementById("fullName").value.trim();
  var email    = document.getElementById("email").value.trim();
  var phone    = document.getElementById("phone").value.trim();
  var location = document.getElementById("location").value.trim();
  var password = document.getElementById("password").value;
  var confirm  = document.getElementById("confirmPassword").value;
  if (password !== confirm) { document.getElementById("errorMsg").innerText = "Passwords do not match."; return; }
  if (password.length < 6)  { document.getElementById("errorMsg").innerText = "Password must be at least 6 characters."; return; }
  if (!isValidEmail(email)) { document.getElementById("errorMsg").innerText = "Invalid email address."; return; }
  var data = { fullName, email, phone, location, password, confirmPassword: confirm };
  try {
    var response = await fetch("/Account/Register", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });
    var result = await response.json();
    if (response.ok && result.success) {
      alert("Registration successful! Please log in.");
      window.location.href = "/Account/Login";
    } else {
      document.getElementById("errorMsg").innerText = result.message || "Registration failed.";
    }
  } catch (ex) {
    document.getElementById("errorMsg").innerText = "Network error. Please try again.";
  }
});
</script>
</body>
</html>