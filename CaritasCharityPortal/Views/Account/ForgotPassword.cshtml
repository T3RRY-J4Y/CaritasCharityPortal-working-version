@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Reset Password – Caritas St Thomas More</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--red:#c8102e;--red-dark:#9b0b21;--gold:#c9944b;--cream:#fdf8f3;--dark:#1c1008;--grey:#7a6858;--border:#e8e0d8;}
body{font-family:'Jost',sans-serif;background:var(--cream);min-height:100vh;display:flex;align-items:stretch}
.auth-page{display:grid;grid-template-columns:1fr 1fr;min-height:100vh;width:100%}

.auth-panel{
  background:linear-gradient(145deg,#1c0a0a 0%,#3a0d1a 60%,#1c0a0a 100%);
  display:flex;flex-direction:column;justify-content:space-between;
  padding:48px;position:relative;overflow:hidden;
}
.auth-panel::before{
  content:'';position:absolute;inset:0;
  background:url('/images/outreach4.jpg') center/cover no-repeat;
  opacity:0.15;
}
.panel-top{position:relative;z-index:1}
.panel-brand{display:flex;align-items:center;gap:12px;margin-bottom:64px}
.panel-logo{width:44px;height:44px;object-fit:contain}
.panel-wordmark strong{display:block;font-family:'Cormorant Garamond',serif;font-size:20px;color:#fff;font-weight:700}
.panel-wordmark span{font-size:11px;color:rgba(255,255,255,0.5);letter-spacing:.5px;text-transform:uppercase}
.panel-heading{font-family:'Cormorant Garamond',serif;font-size:clamp(34px,4vw,48px);font-weight:700;color:#fff;line-height:1.1;margin-bottom:20px}
.panel-heading em{color:var(--gold);font-style:normal}
.panel-sub{font-size:15px;color:rgba(255,255,255,0.65);line-height:1.75}
.panel-bottom{position:relative;z-index:1}
.panel-address{font-size:12px;color:rgba(255,255,255,0.4);display:flex;align-items:center;gap:6px}

.auth-form-side{
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  padding:48px;background:var(--cream);
}
.auth-form-inner{width:100%;max-width:420px}
.auth-back{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--grey);text-decoration:none;margin-bottom:40px;transition:color .2s}
.auth-back:hover{color:var(--red)}
.auth-icon{
  width:60px;height:60px;background:rgba(200,16,46,0.08);border-radius:16px;
  display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--red);margin-bottom:24px;
}
.auth-title{font-family:'Cormorant Garamond',serif;font-size:34px;font-weight:700;color:var(--dark);margin-bottom:6px}
.auth-subtitle{font-size:14px;color:var(--grey);margin-bottom:32px;line-height:1.6}
.field{margin-bottom:20px}
.field label{display:block;font-size:12px;font-weight:700;color:var(--dark);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.field input{
  width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:6px;
  font-family:'Jost',sans-serif;font-size:14px;color:var(--dark);background:#fff;
  transition:border-color .2s,box-shadow .2s;outline:none;
}
.field input:focus{border-color:var(--red);box-shadow:0 0 0 3px rgba(200,16,46,0.08)}
.field input::placeholder{color:#bbb}
.btn-auth{
  width:100%;padding:14px;background:var(--red);color:#fff;border:none;border-radius:6px;
  font-family:'Jost',sans-serif;font-size:15px;font-weight:700;cursor:pointer;
  transition:all .25s;letter-spacing:.3px;
  display:flex;align-items:center;justify-content:center;gap:8px;
}
.btn-auth:hover{background:var(--red-dark);transform:translateY(-1px);box-shadow:0 6px 20px rgba(200,16,46,0.25)}
.success-box{
  display:none;margin-top:16px;padding:14px 16px;
  background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;
  color:#16a34a;font-size:13px;text-align:center;
}
.auth-footer{text-align:center;font-size:13px;color:var(--grey);margin-top:24px}
.auth-footer a{color:var(--red);font-weight:600;text-decoration:none}
.auth-footer a:hover{text-decoration:underline}

@@media(max-width:768px){
  .auth-page{grid-template-columns:1fr}
  .auth-panel{display:none}
  .auth-form-side{padding:32px 24px}
}
</style>
</head>
<body>
<div class="auth-page">

  <div class="auth-panel">
    <div class="panel-top">
      <div class="panel-brand">
        <img src="~/images/logo.png" alt="Caritas Logo" class="panel-logo"/>
        <div class="panel-wordmark">
          <strong>Caritas</strong>
          <span>St Thomas More</span>
        </div>
      </div>
      <h2 class="panel-heading">We've Got You <em>Covered.</em></h2>
      <p class="panel-sub">Don't worry — it happens to the best of us. Enter your email and we'll send you a link to get back into your account.</p>
    </div>
    <div class="panel-bottom">
      <div class="panel-address">
        <i class="fa-solid fa-location-dot"></i>
        55 Tulip Rd, Monavoni AH, Centurion, 0157
      </div>
    </div>
  </div>

  <div class="auth-form-side">
    <div class="auth-form-inner">

      <a href="/Account/Login" class="auth-back">
        <i class="fa-solid fa-arrow-left"></i> Back to Sign In
      </a>

      <div class="auth-icon"><i class="fa-solid fa-lock"></i></div>
      <h1 class="auth-title">Reset Password</h1>
      <p class="auth-subtitle">Enter the email address linked to your account and we'll send you a reset link.</p>

      <form id="forgotForm">
        <div class="field">
          <label>Email Address</label>
          <input type="email" id="resetEmail" placeholder="your.email@example.com" required/>
        </div>
        <button type="submit" class="btn-auth">
          <i class="fa-solid fa-paper-plane"></i> Send Reset Link
        </button>
        <div class="success-box" id="successBox">
          <i class="fa-solid fa-check-circle"></i>
          If that email is registered, a reset link has been sent. Check your inbox.
        </div>
      </form>

      <div class="auth-footer">
        Remembered it? <a href="/Account/Login">Sign in here</a>
      </div>

    </div>
  </div>

</div>
<script>
document.getElementById("forgotForm").addEventListener("submit", function(e) {
  e.preventDefault();
  document.getElementById("successBox").style.display = "block";
  var btn = document.querySelector(".btn-auth");
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-check"></i> Link Sent';
  btn.style.background = "#16a34a";
});
</script>
</body>
</html>