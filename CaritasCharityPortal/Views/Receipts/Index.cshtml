@model List<CaritasCharityPortal.Models.Receipt>
@{
    ViewData["Title"] = "Receipts";
}

<style>
.page-title{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:700;color:#1c1008;margin-bottom:4px}
.page-subtitle{font-size:13px;color:#7a6858}
.page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px}

/* Table */
.table-card{background:#fff;border:1px solid #e8e0d8;border-radius:10px;padding:24px;margin-bottom:24px}
.table-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:8px}
.table-header h3{font-size:15px;font-weight:700;color:#1c1008;margin-bottom:2px}
.table-header p{font-size:12px;color:#9ca3af}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{text-align:left;padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#9ca3af;border-bottom:2px solid #f3f4f6}
.data-table td{padding:12px;border-bottom:1px solid #f9fafb;color:#374151;vertical-align:middle}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:#fdf8f3}
.ref-code{font-family:monospace;font-size:11px;background:#f3f4f6;padding:2px 6px;border-radius:4px;color:#374151}

/* Category chip */
.cat-chip{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:100px;font-size:11px;font-weight:600}
.cat-chip.orange{background:#ffedd5;color:#ea580c}
.cat-chip.blue{background:#dbeafe;color:#1d4ed8}
.cat-chip.purple{background:#f3e8ff;color:#7c3aed}
.cat-chip.green{background:#dcfce7;color:#16a34a}
.cat-chip.red{background:#fee2e2;color:#dc2626}
.cat-chip.grey{background:#f3f4f6;color:#6b7280}

/* Badges */
.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:100px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.badge.green{background:#dcfce7;color:#16a34a}
.badge.yellow{background:#fef9c3;color:#a16207}
.badge.orange{background:#ffedd5;color:#ea580c}
.badge.red{background:#fee2e2;color:#dc2626}

/* Receipt thumbnail */
.receipt-thumb{
    width:56px;height:56px;border-radius:8px;object-fit:cover;
    border:1px solid #e8e0d8;cursor:pointer;transition:transform .2s;
}
.receipt-thumb:hover{transform:scale(1.05)}
.no-image{
    width:56px;height:56px;border-radius:8px;border:1px dashed #e8e0d8;
    display:flex;align-items:center;justify-content:center;
    font-size:18px;color:#d1d5db;
}

/* Delete btn */
.delete-btn{padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;border:none;background:#fee2e2;color:#dc2626;transition:background .2s}
.delete-btn:hover{background:#fecaca}

/* Primary btn */
.primary-btn{display:inline-flex;align-items:center;gap:7px;padding:10px 20px;background:#c8102e;color:#fff;border:none;border-radius:6px;font-family:'Jost',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s}
.primary-btn:hover{background:#9b0b21;transform:translateY(-1px);box-shadow:0 4px 14px rgba(200,16,46,0.25)}

/* Empty */
.empty-state{text-align:center;padding:48px 24px}
.empty-state p{font-size:14px;color:#9ca3af;margin-bottom:16px}

/* ===== MODAL ===== */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(28,16,8,0.5);z-index:500;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.receipt-modal{background:#fff;border-radius:14px;padding:32px;width:100%;max-width:460px;position:relative;box-shadow:0 24px 64px rgba(0,0,0,0.18)}
.modal-close{position:absolute;top:16px;right:16px;background:none;border:none;font-size:22px;color:#9ca3af;cursor:pointer;line-height:1;transition:color .2s}
.modal-close:hover{color:#1c1008}
.modal-title{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:700;color:#1c1008;margin-bottom:4px}
.modal-subtitle{font-size:12px;color:#7a6858;margin-bottom:20px}
.receipt-modal label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#1c1008;margin-bottom:5px;margin-top:14px}
.receipt-modal input,.receipt-modal select{width:100%;padding:10px 12px;border:1.5px solid #e8e0d8;border-radius:6px;font-family:'Jost',sans-serif;font-size:13px;color:#1c1008;background:#fff;outline:none;transition:border-color .2s}
.receipt-modal input:focus,.receipt-modal select:focus{border-color:#c8102e;box-shadow:0 0 0 3px rgba(200,16,46,0.08)}

/* File upload zone */
.file-zone{
    margin-top:6px;border:2px dashed #e8e0d8;border-radius:8px;
    padding:24px;text-align:center;cursor:pointer;transition:all .2s;
    background:#fdf8f3;
}
.file-zone:hover{border-color:#c8102e;background:#fff8f8}
.file-zone i{font-size:28px;color:#d1d5db;margin-bottom:8px;display:block}
.file-zone p{font-size:12px;color:#9ca3af;margin-bottom:4px}
.file-zone span{font-size:11px;color:#c8102e;font-weight:600}
.file-zone input[type=file]{display:none}
.file-selected{font-size:12px;color:#16a34a;margin-top:6px;display:none;align-items:center;gap:5px}

.modal-actions{display:flex;gap:10px;margin-top:20px}
.submit-btn{flex:1;padding:12px;background:#c8102e;color:#fff;border:none;border-radius:6px;font-family:'Jost',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s}
.submit-btn:hover{background:#9b0b21}
.cancel-btn{padding:12px 20px;background:#f3f4f6;color:#374151;border:none;border-radius:6px;font-family:'Jost',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background .2s}
.cancel-btn:hover{background:#e5e7eb}
.form-error{color:#dc2626;font-size:12px;margin-top:8px;display:none}

/* Image preview lightbox */
.lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:900;align-items:center;justify-content:center}
.lightbox img{max-width:90vw;max-height:90vh;border-radius:8px;box-shadow:0 24px 64px rgba(0,0,0,0.5)}
.lightbox-close{position:absolute;top:20px;right:24px;background:none;border:none;color:#fff;font-size:28px;cursor:pointer;line-height:1}
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Receipts</h1>
        <p class="page-subtitle">Upload and manage receipt images for donations and purchases.</p>
    </div>
    <button class="primary-btn" onclick="openReceiptModal()">
        <i class="fa-solid fa-receipt"></i> Add Receipt
    </button>
</div>

<div class="table-card">
    <div class="table-header">
        <div>
            <h3>Receipt Records</h3>
            <p>All uploaded receipts stored on the server.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fa-solid fa-receipt" style="font-size:36px;color:#d1d5db;display:block;margin-bottom:12px;"></i>
            <p>No receipts uploaded yet.</p>
            <button class="primary-btn" onclick="openReceiptModal()">
                <i class="fa-solid fa-plus"></i> Upload First Receipt
            </button>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Receipt ID</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Image</th>
                        <th>Purchase Date</th>
                        <th>Uploaded</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.OrderByDescending(x => x.UploadedAt))
                    {
                        var catClass = r.Category == "Food Parcels" ? "orange"
                                     : r.Category == "Clothing"     ? "blue"
                                     : r.Category == "Blankets"     ? "purple"
                                     : r.Category == "Transport"    ? "green"
                                     : r.Category == "Medical Support" ? "red"
                                     : "grey";
                        var catIcon = r.Category == "Food Parcels"    ? "fa-box"
                                    : r.Category == "Clothing"        ? "fa-shirt"
                                    : r.Category == "Blankets"        ? "fa-bed"
                                    : r.Category == "Transport"       ? "fa-car"
                                    : r.Category == "Medical Support" ? "fa-kit-medical"
                                    : "fa-tag";
                        <tr>
                            <td><span class="ref-code">@r.ReceiptId</span></td>
                            <td style="font-weight:600;max-width:160px;white-space:normal;">@r.Name</td>
                            <td>
                                <span class="cat-chip @catClass">
                                    <i class="fa-solid @catIcon"></i> @r.Category
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.FileLink))
                                {
                                    <img src="@r.FileLink" alt="Receipt" class="receipt-thumb"
                                         onclick="openLightbox('@r.FileLink')"/>
                                }
                                else
                                {
                                    <div class="no-image"><i class="fa-regular fa-image"></i></div>
                                }
                            </td>
                            <td style="font-size:12px;">@r.PurchaseDate.ToString("dd MMM yyyy")</td>
                            <td style="font-size:12px;color:#9ca3af;">@r.UploadedAt.ToString("dd MMM yyyy")</td>
                            <td><span class="badge green">@r.Status</span></td>
                            <td>
                                <button class="delete-btn" data-id="@r.Id" data-link="@r.FileLink">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ===== ADD RECEIPT MODAL ===== -->
<div id="receiptModal" class="modal-overlay">
    <div class="receipt-modal">
        <button class="modal-close" onclick="closeReceiptModal()">×</button>
        <div class="modal-title">Add Receipt</div>
        <div class="modal-subtitle">Upload a receipt image (JPG, PNG or GIF).</div>

        <form id="receiptForm" enctype="multipart/form-data">
            <label>Receipt Name *</label>
            <input type="text" id="receiptName" placeholder="e.g. Food parcel purchase – May 2026" required/>

            <label>Category *</label>
            <select id="category" required>
                <option value="">Select category</option>
                <option>Food Parcels</option>
                <option>Clothing</option>
                <option>Blankets</option>
                <option>Transport</option>
                <option>Medical Support</option>
                <option>Other</option>
            </select>

            <label>Purchase Date *</label>
            <input type="date" id="purchaseDate" required/>

            <label>Receipt Image *</label>
            <div class="file-zone" id="fileZone" onclick="document.getElementById('imageFile').click()">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <p>Click to upload or drag & drop</p>
                <span>JPG, PNG or GIF</span>
                <input type="file" id="imageFile" accept="image/jpeg,image/png,image/gif"/>
            </div>
            <div class="file-selected" id="fileSelected">
                <i class="fa-solid fa-check-circle" style="color:#16a34a;"></i>
                <span id="fileName"></span>
            </div>

            <div class="form-error" id="receiptError"></div>

            <div class="modal-actions">
                <button type="submit" class="submit-btn">Upload Receipt</button>
                <button type="button" class="cancel-btn" onclick="closeReceiptModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
    <button class="lightbox-close" onclick="closeLightbox()">×</button>
    <img id="lightboxImg" src="" alt="Receipt"/>
</div>

<script>
function openReceiptModal()  { document.getElementById("receiptModal").style.display = "flex"; document.getElementById("purchaseDate").valueAsDate = new Date(); }
function closeReceiptModal() { document.getElementById("receiptModal").style.display = "none"; document.getElementById("receiptForm").reset(); document.getElementById("fileSelected").style.display="none"; document.getElementById("receiptError").style.display="none"; }

function openLightbox(src)  { document.getElementById("lightboxImg").src = src; document.getElementById("lightbox").style.display = "flex"; }
function closeLightbox()    { document.getElementById("lightbox").style.display = "none"; }

document.getElementById("imageFile").addEventListener("change", function() {
    if (this.files.length > 0) {
        document.getElementById("fileName").textContent = this.files[0].name;
        document.getElementById("fileSelected").style.display = "flex";
        document.getElementById("fileZone").style.borderColor = "#16a34a";
    }
});

document.getElementById("receiptForm").addEventListener("submit", async function(e) {
    e.preventDefault();
    var errEl = document.getElementById("receiptError");
    errEl.style.display = "none";

    var fileInput = document.getElementById("imageFile");
    if (fileInput.files.length === 0) {
        errEl.textContent = "Please select an image file.";
        errEl.style.display = "block"; return;
    }

    var fd = new FormData();
    fd.append("Name",         document.getElementById("receiptName").value);
    fd.append("Category",     document.getElementById("category").value);
    fd.append("PurchaseDate", document.getElementById("purchaseDate").value);
    fd.append("image",        fileInput.files[0]);

    try {
        var res    = await fetch("/Receipts/Create", { method: "POST", body: fd });
        var result = await res.json();
        if (result.success) { closeReceiptModal(); location.reload(); }
        else { errEl.textContent = result.message || "Upload failed."; errEl.style.display = "block"; }
    } catch(err) {
        errEl.textContent = "Network error. Please try again.";
        errEl.style.display = "block";
    }
});

document.querySelectorAll(".delete-btn").forEach(function(btn) {
    btn.addEventListener("click", async function() {
        if (confirm("Delete this receipt permanently?")) {
            var res = await fetch("/Receipts/Delete?id=" + this.dataset.id + "&fileLink=" + encodeURIComponent(this.dataset.link), { method: "POST" });
            var result = await res.json();
            if (result.success) location.reload();
        }
    });
});
</script>